<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".CreateQuizActivity">

    <!-- Header TextViews -->
    <TextView
        android:id="@+id/tv_quiz_heading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="QUIZ CREATION"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_subject_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Subject: Programming"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tv_quiz_heading"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/tv_teacher_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Teacher: Ms. ABC"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tv_subject_info"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_marks_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Marks: 20"
        android:textSize="16sp"
        app:layout_constraintTop_toTopOf="@id/tv_subject_info"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_time_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Time: 30 Mins"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tv_marks_info"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/divider_top"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/darker_gray"
        app:layout_constraintTop_toBottomOf="@id/tv_teacher_info"
        android:layout_marginTop="8dp"/>

    <!-- ScrollView containing quiz form -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/divider_top"
        app:layout_constraintBottom_toTopOf="@id/btn_add_question"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Question Text -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Enter Question Text:"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/et_question_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Type your question here"
                android:inputType="textMultiLine"
                android:minLines="2"/>

            <!-- Options -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Enter Multiple Choice Options (A, B, C, D):"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/et_option_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Option A" />
            <EditText
                android:id="@+id/et_option_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Option B" />
            <EditText
                android:id="@+id/et_option_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Option C" />
            <EditText
                android:id="@+id/et_option_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Option D" />

            <!-- Correct Answer RadioGroup -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Select the Correct Answer:"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rg_correct_answer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/rb_correct_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A"
                    android:layout_marginEnd="16dp" />
                <RadioButton
                    android:id="@+id/rb_correct_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="B"
                    android:layout_marginEnd="16dp" />
                <RadioButton
                    android:id="@+id/rb_correct_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="C"
                    android:layout_marginEnd="16dp" />
                <RadioButton
                    android:id="@+id/rb_correct_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="D"
                    android:layout_marginEnd="16dp" />
            </RadioGroup>

            <!-- RecyclerView -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Questions Added So Far:"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_questions_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_question" />

        </LinearLayout>
    </ScrollView>

    <!-- Buttons Row -->
    <Button
        android:id="@+id/btn_add_question"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginEnd="8dp"
        android:text="Add Next Question"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_save_quiz"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btn_save_quiz"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginEnd="8dp"
        android:text="Save Quiz"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_view_quiz"
        app:layout_constraintStart_toEndOf="@id/btn_add_question" />

    <Button
        android:id="@+id/btn_view_quiz"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="Preview Quiz"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_save_quiz"
        app:layout_constraintEnd_toEndOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>
